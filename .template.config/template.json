{
  "$schema": "http://json.schemastore.org/template",
  "author": "Galaoox",
  "classifications": [ "Web", "Web API", "Clean Architecture", "Architecture" ],
  "identity": "Galaoox.DotNet.CleanArchitecture.Starter",
  "name": "Clean Architecture Web API Starter (.NET 10)",
  "description": "Clean Architecture ASP.NET Core Web API with PostgreSQL, local JWT auth, Result-based error handling, OpenTelemetry, xUnit v3 tests and architecture enforcement.",
  "shortName": "cleanarch",
  "sourceName": "Company.ProjectName",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "preferNameDirectory": true,
  "guids": [ "company-projectname-api-secrets" ],
  "sources": [
    {
      "source": "./",
      "target": "./",
      "exclude": [
        "**/.git/**",
        "**/bin/**",
        "**/obj/**",
        "**/TestResults/**",
        "**/.idea/**",
        "**/.vs/**",
        "dotnet10.sh",
        "*.md.tmp"
      ]
    }
  ]
}
