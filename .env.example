# Copy to .env for local development. NEVER commit a real .env.
# Values here are local-development defaults only, not secrets.

# PostgreSQL (compose.yaml)
POSTGRES_USER=app
POSTGRES_PASSWORD=localdev
POSTGRES_DB=appdb
POSTGRES_PORT=5432

# API overrides (do not put real secrets here; use user-secrets or real env vars)
# Jwt__Issuer=your-app
# Jwt__Audience=your-app-clients
# Jwt__SigningKey=change-me-at-least-64-chars-long-random-string-xxxxxxxxxxxx
# AdminBootstrap__Email=admin@example.com
# AdminBootstrap__Password=change-me-strong-password
# AdminBootstrap__Enabled=false
# OpenTelemetry__OtlpEndpoint=http://localhost:4317
